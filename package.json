{
  "name": "svc-ads-backend",
  "version": "1.0.0",
  "description": "Backend for SVC ADS",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx prisma generate && tsc && tsc prisma/seed.ts --outDir dist/prisma --esModuleInterop true --target es2022 --moduleResolution node --module commonjs --skipLibCheck",
    "start": "npx prisma migrate deploy && node dist/prisma/prisma/seed.js && node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.3",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
