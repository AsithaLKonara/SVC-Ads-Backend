generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  role             Role      @default(STAFF)
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
