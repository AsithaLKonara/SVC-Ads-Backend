generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  role             Role      @default(STAFF)
  resetToken       String?
  resetTokenExpiry DateTime?

  ads              Ad[]      @relation("UserAds")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?    // lucide-react icon name, e.g. "Car", "Home"
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  attributes  Json?

  ads         Ad[]       @relation("CategoryAds")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum AdStatus {
  ACTIVE
  INACTIVE
}

model Ad {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  price       Float
  condition   String?  // Optional, e.g., "New", "Used"
  images      Json?    // Array of image URLs
  isFeatured  Boolean  @default(false)
  contactPhone String? // Optional contact number for the ad
  attributes  Json?    // Dynamic fields filled for this ad
  
  // Dynamic Locations
  district    String
  city        String
  
  // Relations
  categoryId  String
  category    Category @relation("CategoryAds", fields: [categoryId], references: [id])
  
  userId      String
  user        User     @relation("UserAds", fields: [userId], references: [id])
  
  status      AdStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
